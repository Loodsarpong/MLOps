# Copy this file to .env and fill in real values. Never commit .env.

# --- Experiment tracking ---
# Default to a local file backend; switch to http://host:port for a remote server.
MLFLOW_TRACKING_URI=./mlruns
MODEL_REGISTRY_URI=./mlruns

# --- Storage / data ---
DATA_BUCKET=
DATABASE_URL=

# --- Model serving ---
API_KEY=
SERVING_HOST=0.0.0.0
SERVING_PORT=8000
SERVING_MODEL_PATH=models/iris/model.joblib

# --- Runtime ---
LOG_LEVEL=INFO
ENVIRONMENT=development
