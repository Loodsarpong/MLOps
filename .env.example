# ---- Core ----
NODE_ENV=development
PORT=4000
CORS_ORIGINS=http://localhost:3000

# ---- Database ----
DATABASE_URL=postgres://app:app@localhost:5432/app
REDIS_URL=redis://localhost:6379

# ---- AWS (local dev with MinIO / LocalStack optional) ----
AWS_REGION=us-east-1
S3_INVOICES_BUCKET=ns-invoices
S3_IMPORTS_BUCKET=ns-imports
SQS_QBO_SYNC_URL=
SQS_EMAIL_URL=

# ---- Auth (Cognito) ----
COGNITO_REGION=us-east-1
COGNITO_USER_POOL_ID=placeholder
JWT_ISSUER=https://cognito-idp.us-east-1.amazonaws.com/placeholder
JWT_AUDIENCE=placeholder

# ---- QuickBooks Online ----
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_REDIRECT_URI=http://localhost:4000/v1/integrations/quickbooks/callback
QBO_WEBHOOK_SECRET=

# ---- Notifications ----
# Default From address for outbound mail. The cashier's own address
# (if it's in the allowlist below) wins over this default.
SES_FROM=lsarpong@naturalsheacare.com
# Comma-separated allowlist of permissible From addresses. Any logged-in
# user whose email is in this list will use their own address as From.
SES_FROM_ALLOWLIST=lsarpong@naturalsheacare.com,customer.service@naturalsheacare.com,maddo@naturalsheacare.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# ---- Observability ----
SENTRY_DSN=

# ---- Frontend ----
NEXT_PUBLIC_API_URL=http://localhost:4000/v1
