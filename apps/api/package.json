{
  "name": "@ns/api",
  "version": "0.1.0",
  "private": true,
  "description": "NaturalShea Care ERP — backend API (NestJS)",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "vitest run --config vitest.e2e.config.ts --passWithNoTests",
    "migrate": "node-pg-migrate up -d DATABASE_URL -m ../../db/migrations",
    "migrate:down": "node-pg-migrate down -d DATABASE_URL -m ../../db/migrations",
    "seed": "psql $DATABASE_URL -f ../../db/seeds/01_roles.sql -f ../../db/seeds/02_demo_tenant.sql"
  },
  "dependencies": {
    "argon2": "^0.41.0",
    "@aws-sdk/client-s3": "^3.600.0",
    "@aws-sdk/client-secrets-manager": "^3.600.0",
    "@aws-sdk/client-ses": "^3.600.0",
    "@aws-sdk/client-sqs": "^3.600.0",
    "@aws-sdk/s3-request-presigner": "^3.600.0",
    "@nestjs/common": "^10.3.0",
    "@nestjs/core": "^10.3.0",
    "@nestjs/platform-express": "^10.3.0",
    "@nestjs/schedule": "^4.0.0",
    "@nestjs/swagger": "^7.3.0",
    "@nestjs/terminus": "^10.2.0",
    "bullmq": "^5.1.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^16.4.5",
    "helmet": "^7.1.0",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.2",
    "jwks-rsa": "^3.1.0",
    "kysely": "^0.27.0",
    "nanoid": "^5.0.0",
    "pg": "^8.11.3",
    "pdfkit": "^0.14.0",
    "pino": "^8.17.0",
    "pino-http": "^9.0.0",
    "reflect-metadata": "^0.2.1",
    "rxjs": "^7.8.1",
    "twilio": "^4.20.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.3.0",
    "@nestjs/testing": "^10.3.0",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.11.0",
    "@types/pg": "^8.10.0",
    "@types/pdfkit": "^0.13.0",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.56.0",
    "node-pg-migrate": "^7.0.0",
    "supertest": "^6.3.3",
    "typescript": "^5.3.3",
    "vitest": "^1.2.0"
  }
}
